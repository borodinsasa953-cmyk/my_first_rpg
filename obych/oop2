class Building:
    year = None
    city = None
    def __init__(self, year, city):
        self.year = year
        self.city = city

    def get_info(self):
        print('Year:', self.year, '. City:', self.city)
class School(Building):
    pupils = 0

    def __init__(self,pupils, year, city):
        super().__init__(year, city)
        self.pupils = pupils
        print(self.pupils)
    def get_info(self):
            super().get_info()
            print(f'Pupils: {self.pupils}')
