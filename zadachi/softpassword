
try:
    password = input('Введите пароль: ')
    age = int(input('Введите ваш возраст: '))
    if len(password) < 8:
        print('Пароль слишком короткий')
    elif 14<=age<=99:
        print('Пароль и возраст сохранены!')
    else:
        print('Неправильный возраст!')
except ValueError:
    print('Введите возраст числом!')
