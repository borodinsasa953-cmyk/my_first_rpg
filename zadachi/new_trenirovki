while True:
    print('1. Добавить новую запись')
    print('2. Показать все записи')
    a = input('Выберите действие: ')
    if a == '1': 
        b = input('Введите запись: ')
        with open('training.txt','a', encoding='utf-8') as file:
            file.write(b + '\n')
    elif a == '2':
        try:
            with open('training.txt', 'r', encoding='utf-8') as file:
                print(file.read())
        except FileNotFoundError:
            print('Дневник пуст')